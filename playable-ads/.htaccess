# Playable Ads Configuration - Fix HTTP/2 Protocol Error

# FORCE HTTP/1.1 - Disable HTTP/2 for this folder
<IfModule mod_http2.c>
    H2Engine Off
</IfModule>

# Alternative: Disable SSL/TLS protocols that might have HTTP/2 issues
<IfModule mod_ssl.c>
    SSLEngine On
    SSLProtocol -all +TLSv1.2 +TLSv1.3
</IfModule>

# Enable gzip compression for faster loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript
</IfModule>

# Set proper MIME types
AddType text/html .html
AddDefaultCharset UTF-8

# Cache control - allow browser caching for 1 hour
<FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600"
</FilesMatch>

# Disable directory listing
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
